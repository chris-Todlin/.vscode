<header>
    <h1>To Do App</h1>
    <nav>
        <button onclick="location.href='/add-task'">Add Task</button>
    </nav>
</header>

{{!-- Then a place for th elist of the tasks --}}
<main>
    <article class="list">
        {{!-- A list of task with the title name and delete and edit button --}}

        {{#if tasks}}
            {{#each tasks}}
                <section class="tasks" id="{{id}}">
                    <h2>{{title}}</h2>
                    <p class="body">
                        {{task}}
                    </p>
                    <div class="buttons">
                        <button class="edit">Edit</button>
                        <button class="delete">Delete</button>
                    </div>
            </section>
            {{/each}}
        {{else}}
            <section class="notask">
                <p>Sorry, No any saved Tasks!</p>
            </section>
        {{/if}}
    </article>

    {{!-- Script for the delete and edit button --}}
    <script>
        const deleteBtn = document.querySelectorAll('.delete');
        const editBtn = document.querySelectorAll('.edit');

        if(editBtn.length){
            editBtn.forEach(el => el.addEventListener('click',(e)=>{
                editTask(e.target);
            }));
        }

        // function to edit a task -> padd the id to the server
        function editTask(e){
            location.href = `/edittask/${e.parentElement.parentElement.id}`;
        }
        
    </script>
</main>