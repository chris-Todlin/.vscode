<header>
    <h1>Title</h1>
</header>

<main>
    <form action="/addtask" method="post" class="task">
        <div class="inputs">
            <label for="taskname">Name</label>
            <input type="text" name="name" id="taskname" placeholder="Task name" required>
        </div>
        <div class="inputs">
            <label for="task">Task</label>
            <input type="text" name="task" id="task" placeholder="Task..." required>
        </div>
        <div class="btn">
            <button type="submit">Add Task</button>
        </div>
    </form>
</main>